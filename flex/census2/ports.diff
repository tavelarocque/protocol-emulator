+from common.srdhelper import bitpack
+
+# Port to sigrok-cli 0.7.2: its common.srdhelper has no bitpack_msb. This is
+# DSView's own definition (libsigrokdecode4DSL common/srdhelper/mod.py).
+def bitpack_msb(bits, idx=None):
+    '''Conversion from MSB first bit sequence to integer.'''
+    bits = bits[:]
+    if idx is not None:
+        bits = [b[idx] for b in bits]
+    bits.reverse()
+    return bitpack(bits)
 import sigrokdecode as srd
 
