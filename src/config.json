{
  "//": "DO NOT EDIT THIS FILE before reading the comments below:",

  "//": "This is the default configuration for Tiny Tapeout projects. It should fit most designs.",
  "//": "If you change it, please make sure you understand what you are doing. We are not responsible",
  "//": "if your project fails because of a bad configuration.",

  "//": "!!! DO NOT EDIT THIS FILE unless you know what you are doing !!!",

  "//": "If you get stuck with this config, please open an issue or get in touch via the discord.",

  "//": "Here are some of the variables you may want to change:",

  "//": "PL_TARGET_DENSITY_PCT - You can increase this if Global Placement fails with error GPL-0302.",
  "//": "Users have reported that values up to 80 worked well for them.",
  "PL_TARGET_DENSITY_PCT": 60,

  "//": "This design: AREA 0, as LibreLane had it until 3.1.0.dev4 made DELAY 4",
  "//": "the default; DELAY 4 buffered and duplicated logic into 29% more cells.",
  "SYNTH_STRATEGY": "AREA 0",

  "//": "CLOCK_PERIOD - Increase this in case you are getting setup time violations.",
  "//": "The value is in nanoseconds, so 20ns == 50MHz.",
  "//": "This design: 20 ns (50 MHz). v1.4, with its program in flip-flops,",
  "//": "needed 25. With the SRAM macros, layouts at 25, 20 and 16 ns all met",
  "//": "timing at every corner, the slow corner with about 9, 4 and under 1 ns",
  "//": "between flip-flops to spare; 20 keeps a margin.",
  "CLOCK_PERIOD": 20,

  "//": "Hold slack margin - Increase them in case you are getting hold violations.",
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,

  "//": "RUN_LINTER, LINTER_INCLUDE_PDK_MODELS - Disabling the linter is not recommended!",
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "//": "If you need a custom clock configuration, read the following documentation first:",
  "//": "https://tinytapeout.com/faq/#how-can-i-map-an-additional-external-clock-to-one-of-the-gpios",
  "CLOCK_PORT": "clk",

  "//": "======== IHP SRAM macros: a program memory per thread (RM_IHPSG13_1P_256x16_c2_bm_bist) and the packet buffer ========",
  "//": "Integration from https://github.com/TinyTapeout/ttihp-cmos5l-sram-example (Apache-2.0):",
  "//": "librelane_plugin_sram_pdn.py, odb_stripes.py, src/pdn_cfg.tcl, src/sram_bb.v, test/sram_model.",

  "//": "Insert the Project.ExtendPowerStripes step (librelane_plugin_sram_pdn.py) after the PDN generator.",
  "meta": {
    "flow": "Classic",
    "substituting_steps": {
      "+OpenROAD.GeneratePDN": "Project.ExtendPowerStripes",
      "-OpenROAD.DetailedRouting": "Odb.InsertECOBuffers"
    }
  },

  "//": "All three along the bottom, flipped (FS) so their pins face up towards the logic.",
  "//": "x = 3.36 + n x 11.24 um keeps each macro's power columns under the PDN stripes (n = 0, 24 and 48).",
  "//": "The packet buffer (RM_IHPSG13_1P_1024x16_c2_bm_bist) is the same width as the program memories",
  "//": "(236.8 um) with the same power columns, and 336.46 um tall where they are 118.78.",
  "MACROS": {
    "RM_IHPSG13_1P_256x16_c2_bm_bist": {
      "instances": {
        "u_protocol_emulator.sram0": { "location": [3.36, 3.78], "orientation": "FS" },
        "u_protocol_emulator.sram1": { "location": [273.12, 3.78], "orientation": "FS" }
      },
      "gds": ["pdk_dir::libs.ref/sg13cmos5l_sram/gds/RM_IHPSG13_1P_256x16_c2_bm_bist.gds"],
      "lef": ["pdk_dir::libs.ref/sg13cmos5l_sram/lef/RM_IHPSG13_1P_256x16_c2_bm_bist.lef"],
      "lib": {
        "*_typ_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_256x16_c2_bm_bist_typ_1p20V_25C.lib"],
        "*_fast_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_256x16_c2_bm_bist_fast_1p32V_m55C.lib"],
        "*_slow_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_256x16_c2_bm_bist_slow_1p08V_125C.lib"]
      }
    },
    "RM_IHPSG13_1P_1024x16_c2_bm_bist": {
      "instances": {
        "u_protocol_emulator.sram_buf": { "location": [542.88, 3.78], "orientation": "FS" }
      },
      "gds": ["pdk_dir::libs.ref/sg13cmos5l_sram/gds/RM_IHPSG13_1P_1024x16_c2_bm_bist.gds"],
      "lef": ["pdk_dir::libs.ref/sg13cmos5l_sram/lef/RM_IHPSG13_1P_1024x16_c2_bm_bist.lef"],
      "lib": {
        "*_typ_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x16_c2_bm_bist_typ_1p20V_25C.lib"],
        "*_fast_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x16_c2_bm_bist_fast_1p32V_m55C.lib"],
        "*_slow_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x16_c2_bm_bist_slow_1p08V_125C.lib"]
      }
    }
  },

  "//": "The SRAM has two supply rails (VDD!, VDDARRAY!) and one ground rail (VSS!).",
  "PDN_MACRO_CONNECTIONS": [
    "u_protocol_emulator.sram0 VPWR VGND VDD! VSS!",
    "u_protocol_emulator.sram0 VPWR VGND VDDARRAY! VSS!",
    "u_protocol_emulator.sram1 VPWR VGND VDD! VSS!",
    "u_protocol_emulator.sram1 VPWR VGND VDDARRAY! VSS!",
    "u_protocol_emulator.sram_buf VPWR VGND VDD! VSS!",
    "u_protocol_emulator.sram_buf VPWR VGND VDDARRAY! VSS!"
  ],

  "//": "PDN: pdngen skips the SRAMs; ExtendPowerStripes powers them.",
  "PDN_CFG": "dir::pdn_cfg.tcl",
  "EXTEND_STRIPES_SRAM_ARRAY_EVERY_OTHER": true,
  "//": "pdngen checks the SRAM's power connections before ExtendPowerStripes makes them, so errors are expected at this stage.",
  "ERROR_ON_PDN_VIOLATIONS": 0,

  "//": "Magic DRC flags many errors inside the SRAM macro; the Tiny Tapeout precheck runs the full KLayout deck on the final GDS.",
  "RUN_MAGIC_DRC": 0,

  "//": "Magic extracts the SRAM from its LEF abstract, so the power stripes crossing the macro's",
  "//": "Metal4 obstruction show up as illegal overlaps (there is no metal there in the GDS).",
  "ERROR_ON_ILLEGAL_OVERLAPS": 0,

  "//": "Design repair once more after global routing. The repair after placement works from estimated",
  "//": "wires; the routed ones came out up to twice as long at the SRAMs, which sit along the bottom edge",
  "//": "far from much of the logic. That left 15 SRAM data outputs driving more than the 64 fF the macro",
  "//": "is characterised for (the worst 102 fF), five SRAM inputs with edges slower than the macro allows",
  "//": "(the worst 1.5 ns against 0.6 ns at the slow corner), and one net over the cell library's limit.",
  "//": "Repairing against the routed wires, to three quarters of each limit, leaves room for what detailed",
  "//": "routing still changes.",
  "RUN_POST_GRT_DESIGN_REPAIR": 1,
  "GRT_DESIGN_REPAIR_MAX_CAP_PCT": 25,
  "GRT_DESIGN_REPAIR_MAX_SLEW_PCT": 25,

  "//": "======== A buffer beside every SRAM pin the logic uses ========",
  "//": "The macros' limits are the ends of their characterisation tables: 64 fF on a data output, an",
  "//": "edge of 0.48 ns on an input. The repair steps put a buffer where the cells it feeds are, not at",
  "//": "the pin, so 15 outputs drove up to 102 fF of wire and five inputs saw edges of up to 1.5 ns.",
  "//": "LibreLane's own step for inserting a buffer at a named pin (above, just before detailed routing,",
  "//": "so that no later repair moves or removes them) puts one beside each: a buf_8 after each data",
  "//": "output, in the first row clear of the macro's halo, and a buf_2 before each address, data and",
  "//": "enable input, in the row above. x is the pin's own, from the macro's LEF. The clock is left to",
  "//": "clock tree synthesis, and the inputs tied to constants need none.",
