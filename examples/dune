; One standalone assembly file per firmware, generated from model/firmware.ml
; and promoted here, so these cannot drift from what the tests run.

(rule
 (targets uart_tx.s)
 (mode promote)
 (action
  (with-stdout-to
   uart_tx.s
   (run %{dep:../bin/firmware_src.exe} uart_tx %{dep:../model/firmware.ml}))))

(rule
 (targets uart_rx.s)
 (mode promote)
 (action
  (with-stdout-to
   uart_rx.s
   (run %{dep:../bin/firmware_src.exe} uart_rx %{dep:../model/firmware.ml}))))

